# BFF configuration (server/config.ts).
# Copy to .env for reference, or set these directly in the Render dashboard.
# Nothing here is read automatically - the BFF reads process.env.

# Port the BFF listens on. Render injects this automatically; do not set it there.
PORT=9000

# Base URL of the Spring Boot COMPLY API.
#   local  : http://localhost:8080
#   Render : the app service URL, e.g. https://comply-api.onrender.com
COMPLY_API_BASE_URL=http://localhost:8080

# How long to wait for the COMPLY API before returning 504.
# Render free-tier services spin down when idle, so a cold start can be slow.
COMPLY_API_TIMEOUT_MS=15000

# Browser origins allowed to call the BFF cross-origin, comma separated.
# Only needed when the UI is served from a DIFFERENT origin than the BFF.
# When the BFF serves the built Angular app the request is same-origin and
# this is unused.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Optional allowlist of URL prefixes accepted by the apiEndpoint parameter of
# POST /api/comply/external-api/concurrent. Comma separated. When unset the
# value is forwarded unvalidated, which lets a caller aim the app service at
# an arbitrary host - set this before exposing the BFF publicly.
# COMPLY_EXTERNAL_API_ALLOWLIST=https://api.partner.example

NODE_ENV=development
