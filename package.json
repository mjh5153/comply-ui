{
  "name": "angular-forms-course",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve  --proxy-config ./proxy.json",
    "server": "ts-node --transpile-only -P ./server/server.tsconfig.json ./server/server.ts",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "start:prod": "npm run server",
    "test:bff": "vitest run --config vitest.bff.config.mts",
    "typecheck:bff": "tsc -p server/server.tsconfig.json --noEmit",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.2",
    "@angular/cdk": "^22.1.3",
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/material": "^22.1.3",
    "@angular/material-moment-adapter": "22.1.3",
    "@angular/platform-browser": "22.1.2",
    "@angular/platform-browser-dynamic": "22.1.2",
    "@angular/router": "22.1.2",
    "core-js": "^2.4.1",
    "cors": "^2.8.5",
    "express": "^4.16.2",
    "express-fileupload": "^1.2.0",
    "moment": "^2.22.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.0.0"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "^22.1.4",
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "22.1.2",
    "@angular/language-service": "22.1.2",
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.0.39",
    "@types/node": "^22.10.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.0.1",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
